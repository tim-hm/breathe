# Rust
/target/
**/*.rs.bk

# The Xcode project is generated from ios/project.yml by `mise run ios:gen`.
# Committing it would reintroduce exactly the pbxproj merge conflicts that
# choosing XcodeGen was meant to avoid.
ios/*.xcodeproj/
ios/*.xcworkspace/
# Also generated from project.yml — XcodeGen writes the target's Info.plist from
# its `info:` block. Committing it would leave two editable sources for one Info
# dictionary, where hand edits silently vanish on the next generate.
ios/Ond/Info.plist
ios/OndWatch/Info.plist
# Same again for the entitlements XcodeGen writes from each `entitlements:` block.
ios/Ond/Ond.entitlements
ios/OndWatch/OndWatch.entitlements
ios/**/.build/
DerivedData/
*.xcuserstate
xcuserdata/

# Secrets. `.env` holds exactly one value locally — OPENROUTER_API_KEY, the
# assistant's provider key, loaded by .mise.toml so every task sees it. It is
# optional: absent, the assistant answers from its rule-based fallback and
# everything else behaves identically, which is what CI and a fresh clone get.
# Nothing else belongs in it (CLAUDE.md §1.4).
.env
.env.*
*.pem
*.key

# macOS
.DS_Store

# Per-developer mise overrides — mise reads these automatically if present.
mise.local.toml
.mise.local.toml

# Agent scratch
/logs/
/tmp/
.claude/*
!.claude/skills/

# vp needs a package.json at the root; nothing here installs dependencies, but
# a stray `pnpm dlx` can still leave this behind.
node_modules/
