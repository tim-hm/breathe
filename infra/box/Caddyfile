# TLS termination and the only public entrance. Caddy provisions and renews
# the certificate itself via ACME; port 80 exists for the challenge and the
# HTTPS redirect. gRPC-Web is plain HTTP POST underneath, so an ordinary
# reverse proxy is all the transport needs.
#
# The hostname must resolve before first boot, or certificate issuance fails
# and retries with backoff. Its A record is applied from infra/main.tf, so what
# is actually being waited on is the NS delegation at the registrar.
#
# This name is the same literal as the Route53 zone in infra/main.tf. Nothing
# renders this file — deploy rsyncs it as-is — so the two are kept in step by
# hand, and both say so.
ondbreathe.app {
	# One host serves both the API and the marketing page, split by path rather
	# than by hostname — one A record, one certificate.
	#
	# The API side is enumerated and the site is the fallback, never the other
	# way round. gRPC-Web paths are always /<proto package>.<Service>/<Method>,
	# so matching the package prefix covers every service the contract will ever
	# grow without touching this file. A static file can therefore never shadow
	# an RPC, and a new RPC can never fall through into a 404 from file_server.
	#
	# /grpc.reflection.* is deliberately absent: crates/api/src/grpc.rs registers
	# reflection on local environments only, so the path falls through to
	# file_server and 404s. Stated here as well as there because an unset
	# OND_ENV falls back to dev — the gate in the binary fails open, and this
	# is what still says no to a box booted without it.
	@api path /ond.v1.* /health /about

	# No rate limiting here, deliberately: Caddy's is an xcaddy plugin, and
	# building a custom image for it would mean a second `docker save | ssh
	# docker load` leg in a deploy that has one of each. The ration lives in
	# crates/api/src/throttle.rs instead, which is also what lets tests/e2e
	# drive it. What this proxy does contribute is the key that limiter counts
	# against: reverse_proxy appends the peer it accepted to X-Forwarded-For,
	# and the limiter reads that right-most entry.
	handle @api {
		reverse_proxy api:18100
	}

	handle {
		root * /srv/web

		encode zstd gzip

		# Extensionless URLs, because the app ships them as literals:
		# `LegalLinks.privacyPolicy` is `https://ondbreathe.app/privacy`, and
		# App Review rejects a paywall whose privacy link 404s. `file_server`
		# alone resolves neither `/privacy` nor `/support`.
		try_files {path} {path}.html {path}/index.html

		file_server
	}
}
